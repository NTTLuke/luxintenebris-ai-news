      "title": "Research & Papers",
      "items": [
        {
          "title": "RRSI: Regularized recursive self-improvement of agent harnesses",
          "summary": "Because an agent's harness (prompts, control flow, tooling, memory) drives capability, this work regularizes recursive self-improvement of the harness itself, curbing memorization of training tasks while preserving gains.",
          "source": "arXiv",
          "url": "https://arxiv.org/abs/2609.24972",
          "date": "2026-09-21",
          "image": "images/section_research-papers_2026-09-22.jpg"
        },
        {
          "title": "ARM: Attention with routed-memory for learnable sparse control",
          "summary": "A differentiable, fixed-size routed-memory KV cache learns which information to retain in long-context inference, beating selective eviction and pruning baselines by keeping core context in a learned sparse control path.",
          "source": "arXiv",
          "url": "https://arxiv.org/abs/2609.24417",
          "date": "2026-09-21"
        },
        {
          "title": "KV-COBRA: KV cache compression via co-optimized bit-rank allocation",
          "summary": "The real limiter at extreme compression rates is how the budget is spread across heads; co-optimizing per-head low-rank truncation and scalar quantization dominates uniform allocation, with the biggest gains at low bit-rates.",
          "source": "arXiv",
          "url": "https://arxiv.org/abs/2609.24298",
          "date": "2026-09-21"
        },
        {
          "title": "TTSE: a two-track online self-evolution framework",
          "summary": "Agents evolve their own capabilities online in continuously interactive environments, treating environmental knowledge as living input rather than fixed data, and beat RL baselines that adapt to fixed task distributions.",
          "source": "arXiv",
          "url": "https://arxiv.org/abs/2609.24289",
          "date": "2026-09-21"
        },
        {
          "title": "Fathom-Vaidya: medical reasoning with rubric-based rewards",
          "summary": "Training LLMs on rubric-based rewards spanning diagnostic and multi-turn clinical reasoning improves performance on HealthBench and MedXpert relative to standard reward schemes.",
          "source": "arXiv",
          "url": "https://arxiv.org/abs/2609.24480",
          "date": "2026-09-21"
        }
      ]
    },
