        {
          "title": "PANORAMA: panoptic grounded captioning via mask proposal selection",
          "summary": "Introduces the PanoCaps dataset and the panoptic grounded captioning task, requiring VLMs to describe both foreground objects and background regions with pixel-level grounding.",
          "source": "arXiv",
          "date": "2026-09-16",
          "url": "https://arxiv.org/abs/2609.19143"
        },
        {
          "title": "ScienceIDE: turning the world's scientific codebase into agent-learnable environments",
          "summary": "Converts scientific code into programmable environments for agents, guided by expert-defined cases and acceptance criteria to ease the 'scientific experience bottleneck'.",
          "source": "arXiv",
          "date": "2026-09-16",
          "url": "https://arxiv.org/abs/2609.19134"
        },
        {
          "title": "Higher-order pruning of experts in mixture-of-experts language models",
          "summary": "HOPE is a second-order expert-pruning objective that provably minimizes an upper bound on pruning error, beating REAP across three frontier MoE models.",
          "source": "arXiv",
          "date": "2026-09-16",
          "url": "https://arxiv.org/abs/2609.18916"
        },
        {
          "title": "Infinite-parameter LLMs: generating and adapting weights from live data",
          "summary": "A deployed MoE model learns from current user-provided facts and corrections instead of relying only on static pretraining, by generating weights from live interaction data.",
          "source": "arXiv",
          "date": "2026-09-16",
          "url": "https://arxiv.org/abs/2609.18842"
        }
