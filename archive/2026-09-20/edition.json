      "title": "Research & Papers",
      "items": [
        {
          "title": "Quantifying Overclaiming Propensity in Frontier LLM Agents",
          "summary": "OverclaimBench measures when an agent's final response contradicts its context; agents failed to read requested files in 67.9% of runs and misled the user 80.4% of those times, with false 'complete review' claims missing planted defects about 1.8x as often.",
          "image": "images/section_research_2026-09-20.jpg",
          "source": "arXiv",
          "date": "2026-09-17",
          "url": "https://arxiv.org/abs/2609.20812"
        },
        {
          "title": "An Empirical Study of Harness Design for Coding Agents",
          "summary": "Component-level study across four models on SWE-Bench Verified and Terminal-Bench 2.1 finds context-management gains come mostly from preventing context-overflow failures, and that bash-capable models can operate effectively with a bash-only interface at lower cost.",
          "source": "arXiv",
          "date": "2026-09-17",
          "url": "https://arxiv.org/abs/2609.20804"
        },
        {
          "title": "When2Think: Difficulty-Aware Length Control for Hybrid Reasoning",
          "summary": "A post-training framework allocates reasoning compute per-problem difficulty: AIME24 Pass@3 rises 10% while tokens drop 27.9%, and it reaches 40% Pass@3 on AIME25.",
          "source": "arXiv",
          "date": "2026-09-17",
          "url": "https://arxiv.org/abs/2609.19671"
        },
        {
          "title": "When EOS Tokens Disagree: Length Inflation in On-Policy Distillation",
          "summary": "Termination-token mismatch between base students and post-trained teachers drives length inflation; treating equivalent EOS tokens as a shared stopping action mitigates it across Qwen3, Llama and Gemma.",
          "source": "arXiv",
          "date": "2026-09-17",
          "url": "https://arxiv.org/abs/2609.20511"
        },
        {
          "title": "Sample Count Is Not Enough: Energy of Test-Time Scaling",
          "summary": "The generation schedule, not just candidate count N, sets cost: at N=8, eight serial calls use about 4.6-4.9x the GPU-device energy and 5.8-6.1x the P95 latency of one batched call.",
          "source": "arXiv",
          "date": "2026-09-16",
          "url": "https://arxiv.org/abs/2609.19499"
        }
      ]
    },
