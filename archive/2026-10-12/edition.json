  "lead": {
    "kicker": "Swarm intelligence",
    "title": "Git-based agent swarms sweep IMOProofBench-Advanced, solving all 30 problems",
    "summary": "A new Meta Superintelligence Labs paper on compounding inference has hundreds of asynchronous agents share one Git repo as persistent memory, with each contribution a commit that cites prior work across branches and no central planner. Using GPT-5.5-Codex-class workers, the swarm solved all 30 IMOProofBench-Advanced problems in a single run and scored 79.4% on ProgramBench versus 65.1% for a single agent at similar compute, scaling from 73.1% at 100 workers to 79.4% at 500.",
    "source": "@omarsar0 (X)",
    "date": "2026-10-11",
    "url": "https://x.com/omarsar0/status/2109287161199812802",
    "image": "images/lead_2026-10-12.png"
  },
