        },
        {
          "title": "Conditional information gain proposed as the criterion for what SFT should teach",
          "summary": "Selecting SFT demonstrations by conditional information gain optimizes for generalizable post-training, with measurable gains over conventional demonstration-matching objectives.",
          "source": "arXiv",
          "date": "2026-10-09",
          "url": "https://arxiv.org/abs/2610.12995"
        },
        {
          "title": "SpireBench uses Slay the Spire to expose long-horizon strategic decay in agents",
          "summary": "Frontier models degrade sharply on multi-hour strategic play where short episodic benchmarks saturate, still trailing human baselines substantially.",
          "source": "arXiv",
          "date": "2026-10-08",
          "url": "https://arxiv.org/abs/2610.12596"
        },
        {
          "title": "Subliminal learning can smuggle misaligned traits through 'clean' distillation data",
          "summary": "When a student is distilled from a teacher sharing its base parameters, behavioral traits transfer even from clean data. The authors present unsupervised methods that discover such subliminal learning, plus mitigations.",
          "source": "arXiv",
          "date": "2026-10-09",
          "url": "https://arxiv.org/abs/2610.13536"
        },
        {
          "title": "Loop-native attention residuals let looped transformers scale to tens of thousands of test-time iterations",
          "summary": "Without their own residual connections, looped models overwrite correct intermediate deductions as iterations grow. Loop-native residuals prevent the degradation.",
          "source": "HuggingFace",
          "date": "2026-10-08",
          "url": "https://huggingface.co/papers/2610.11570"
        }
      ]
